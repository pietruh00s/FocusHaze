<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FocusHaze.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FocusHaze.Localization"
    Title="FocusHaze">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/FocusHaze.png" Width="16" Height="16" />
                <TextBlock Text="FocusHaze" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,4,24,24" Spacing="4" MaxWidth="720">

                <TextBlock loc:Localize.Key="AppHeading" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />
                <TextBlock loc:Localize.Key="AppDescription" Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,0,16" />

                <!-- Enabled -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE706;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock loc:Localize.Key="Enabled_Title" />
                            <TextBlock x:Name="HotkeyText" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="EnabledToggle" Grid.Column="2" OnContent="" OffContent=""
                                      MinWidth="0" Toggled="OnEnabledToggled" />
                    </Grid>
                </Border>

                <!-- Intensity -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE793;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock loc:Localize.Key="Intensity_Title" />
                            <TextBlock loc:Localize.Key="Intensity_Description" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock x:Name="IntensityText" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right" />
                            <Slider x:Name="IntensitySlider" Width="200" Minimum="5" Maximum="90" StepFrequency="1"
                                    VerticalAlignment="Center" ValueChanged="OnIntensityChanged" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Color -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock loc:Localize.Key="Color_Title" />
                            <TextBlock loc:Localize.Key="Color_Description" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <DropDownButton x:Name="ColorButton" Grid.Column="2" VerticalAlignment="Center">
                            <Border x:Name="ColorSwatch" Width="32" Height="20" CornerRadius="4"
                                    BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="12">
                                        <StackPanel x:Name="PresetPanel" Orientation="Horizontal" Spacing="8" />
                                        <ColorPicker x:Name="HazeColorPicker"
                                                     IsAlphaEnabled="False"
                                                     IsMoreButtonVisible="False"
                                                     IsColorSliderVisible="True"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="True"
                                                     ColorChanged="OnColorChanged" />
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                </Border>

                <!-- Animation -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon Glyph="&#xE916;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock loc:Localize.Key="Animate_Title" />
                            <TextBlock loc:Localize.Key="Animate_Description" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AnimateToggle" Grid.Column="2" OnContent="" OffContent=""
                                      MinWidth="0" Toggled="OnAnimateToggled" />

                        <StackPanel x:Name="FadePanel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <TextBlock loc:Localize.Key="FadeDuration_Label" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="FadeText" VerticalAlignment="Center" MinWidth="56" TextAlignment="Right" />
                            <Slider x:Name="FadeSlider" Width="200" Minimum="50" Maximum="800" StepFrequency="10"
                                    VerticalAlignment="Center" ValueChanged="OnFadeChanged" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Displays -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock loc:Localize.Key="ActiveDisplay_Title" />
                            <TextBlock loc:Localize.Key="ActiveDisplay_Description" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ActiveDisplayToggle" Grid.Column="2" OnContent="" OffContent=""
                                      MinWidth="0" Toggled="OnActiveDisplayToggled" />
                    </Grid>
                </Border>

                <TextBlock loc:Localize.Key="Section_App" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />

                <!-- Language -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xF2B7;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock loc:Localize.Key="Language_Title" />
                            <TextBlock loc:Localize.Key="Language_Description" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageCombo" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                  SelectionChanged="OnLanguageChanged" />
                    </Grid>
                </Border>

                <!-- Startup -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock loc:Localize.Key="Startup_Title" />
                            <TextBlock loc:Localize.Key="Startup_Description" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" OnContent="" OffContent=""
                                      MinWidth="0" Toggled="OnStartupToggled" />
                    </Grid>
                </Border>

                <!-- Quit -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7C3;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock loc:Localize.Key="Background_Title" />
                            <TextBlock loc:Localize.Key="Background_Description" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <Button loc:Localize.Key="Quit_Button" Grid.Column="2" VerticalAlignment="Center" Click="OnQuitClicked" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
