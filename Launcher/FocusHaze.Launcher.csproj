<Project Sdk="Microsoft.NET.Sdk">

  <!-- Root-folder launcher for release packages; starts app\FocusHaze.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FocusHaze</AssemblyName>
    <RootNamespace>FocusHaze.Launcher</RootNamespace>
    <ApplicationIcon>..\Assets\FocusHaze.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAppConfig>false</GenerateAppConfig>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <AssemblyTitle>FocusHaze</AssemblyTitle>
    <Description>FocusHaze launcher</Description>
  </PropertyGroup>

</Project>
